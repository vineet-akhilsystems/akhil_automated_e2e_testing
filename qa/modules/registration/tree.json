{
  "module": "registration",
  "version": 1,
  "note": "Match rules: a case goes to the node with the most matching keys; equal scores go to the first node in file order (so an action-only group such as Update beats a registration-type variant on a tie).",
  "nodes": [
    {
      "id": "login",
      "name": "Login and facility",
      "kind": "root",
      "note": "Shared start of every test: the portal saved login session and chosen facility."
    },
    {
      "id": "open-registration",
      "name": "Open Registration",
      "parent": "login",
      "kind": "step",
      "note": "Navigate to the Registration page."
    },
    {
      "id": "search",
      "name": "Search",
      "parent": "open-registration",
      "kind": "group",
      "match": {
        "action": [
          "search"
        ]
      },
      "note": "Patient search; no registration type."
    },
    {
      "id": "update",
      "name": "Update an existing patient",
      "parent": "open-registration",
      "kind": "group",
      "match": {
        "action": [
          "update"
        ]
      },
      "note": "Most cases here need a saved patient (see {{name@CASE-ID}} references)."
    },
    {
      "id": "new",
      "name": "New Registration",
      "parent": "open-registration",
      "kind": "variant",
      "match": {
        "registrationType": [
          "New Registration"
        ]
      }
    },
    {
      "id": "newborn",
      "name": "New Born Registration",
      "parent": "open-registration",
      "kind": "variant",
      "match": {
        "registrationType": [
          "New Born Registration"
        ]
      }
    },
    {
      "id": "international",
      "name": "International Registration",
      "parent": "open-registration",
      "kind": "variant",
      "match": {
        "registrationType": [
          "International Registration"
        ]
      }
    },
    {
      "id": "outside",
      "name": "Outside Registration",
      "parent": "open-registration",
      "kind": "variant",
      "match": {
        "registrationType": [
          "Outside Registration"
        ]
      }
    },
    {
      "id": "staff",
      "name": "Staff Registration",
      "parent": "open-registration",
      "kind": "variant",
      "match": {
        "registrationType": [
          "Staff Registration"
        ]
      }
    },
    {
      "id": "diagnostic",
      "name": "Diagnostic Registration",
      "parent": "open-registration",
      "kind": "variant",
      "match": {
        "registrationType": [
          "Diagnostic Registration"
        ]
      }
    },
    {
      "id": "new-phone",
      "name": "Phone",
      "parent": "new",
      "kind": "group",
      "match": {
        "registrationType": [
          "New Registration"
        ],
        "category": [
          "phone"
        ]
      }
    },
    {
      "id": "new-dob-age",
      "name": "Date of birth and age",
      "parent": "new",
      "kind": "group",
      "match": {
        "registrationType": [
          "New Registration"
        ],
        "category": [
          "dob-age"
        ]
      }
    },
    {
      "id": "new-mandatory",
      "name": "Mandatory fields",
      "parent": "new",
      "kind": "group",
      "match": {
        "registrationType": [
          "New Registration"
        ],
        "category": [
          "mandatory"
        ]
      }
    },
    {
      "id": "new-name",
