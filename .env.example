# Copy to .env and fill in. Never commit .env. Placeholder values only.

# Target application (legacy single-target mode; per-project targets are set in Settings > login profiles)
BASE_URL=https://demo.augastam.com
AUGASTAM_USER=
AUGASTAM_PASS=
AUGASTAM_TENANT=Miracle HIS Demo
AUGASTAM_FACILITY=Akhil Demo2 Delhi
AUGASTAM_ROLE=Admin

# Test Studio (npm run portal). Local by default; the Docker image sets 0.0.0.0 inside the container.
PORTAL_HOST=127.0.0.1
PORTAL_PORT=4173
# Host port published by docker compose (the container port stays 4173)
# PORTAL_PORT_PUBLISHED=4173

# First administrator, created on first start when no users exist. Change the password after signing in.
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Legacy shared workspace key (at least 16 characters) when binding to a network interface
# PORTAL_ACCESS_TOKEN=

# Parallel test workers (each runs its own Chromium; budget roughly 1 GB RAM and 1 CPU each)
PORTAL_WORKERS=2

# Maximum size in MB of an uploaded intake file (video, document, screenshot)
INTAKE_MAX_MB=500

# Optional AI insights. Leave blank to disable.
ANTHROPIC_API_KEY=
INSIGHTS_MODEL=your-model-id

# Paths and proxy
# PORTAL_DATA_DIR=.portal
# PORTAL_PYTHON=python
# PORTAL_PUBLIC_HOST=testing.your-internal-domain.example
# PORTAL_ENVIRONMENTS=[{"id":"demo","name":"Demo","url":"https://demo.augastam.com","authDir":".auth"}]
